<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:agent="http://fluxnova.finos.org/schema/1.0/ai/agent"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://fluxnova.finos.org/poc/agentic">
  <process id="agenticPoc" name="Loan Processing POC" isExecutable="true" camunda:historyTimeToLive="1">
    <startEvent id="start"/>
    <subProcess id="agentContainer" name="Loan Officer Agent Review">
      <extensionElements>
        <agent:config provider="ollama" model="gemma3:1b" systemPrompt="You are a loan processing officer. Review the loan application context and the applicant message. Produce a clear recommendation (APPROVE / REVIEW / REJECT), the key reasons, missing information (if any), and the next actions for a human loan team. If data is insufficient, ask precise follow-up questions."/>
        <agent:context>
          <agent:variable name="applicantId"/>
          <agent:variable name="loanAmount"/>
          <agent:variable name="annualIncome"/>
          <agent:variable name="creditScore"/>
          <agent:variable name="loanPurpose"/>
          <agent:variable name="applicantMessage"/>
        </agent:context>
      </extensionElements>
      <startEvent id="agentStart"/>
      <serviceTask id="agentTurn" name="Loan Officer Turn" camunda:delegateExpression="${agentTurnDelegate}"/>
      <endEvent id="agentEnd"/>
      <sequenceFlow id="agentFlow1" sourceRef="agentStart" targetRef="agentTurn"/>
      <sequenceFlow id="agentFlow2" sourceRef="agentTurn" targetRef="agentEnd"/>
    </subProcess>
    <userTask id="reviewTask" name="Human Loan Review"/>
    <endEvent id="end"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="agentContainer"/>
    <sequenceFlow id="flow2" sourceRef="agentContainer" targetRef="reviewTask"/>
    <sequenceFlow id="flow3" sourceRef="reviewTask" targetRef="end"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_agenticPoc">
    <bpmndi:BPMNPlane id="BPMNPlane_agenticPoc" bpmnElement="agenticPoc">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <dc:Bounds x="100" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_agentContainer" bpmnElement="agentContainer" isExpanded="true">
        <dc:Bounds x="180" y="80" width="460" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_reviewTask" bpmnElement="reviewTask">
        <dc:Bounds x="690" y="120" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <dc:Bounds x="860" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
        <di:waypoint x="136" y="160"/>
        <di:waypoint x="180" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
        <di:waypoint x="640" y="160"/>
        <di:waypoint x="690" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow3" bpmnElement="flow3">
        <di:waypoint x="830" y="160"/>
        <di:waypoint x="860" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="BPMNShape_agentStart" bpmnElement="agentStart">
        <dc:Bounds x="220" y="192" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_agentTurn" bpmnElement="agentTurn">
        <dc:Bounds x="300" y="170" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_agentEnd" bpmnElement="agentEnd">
        <dc:Bounds x="520" y="192" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_agentFlow1" bpmnElement="agentFlow1">
        <di:waypoint x="256" y="210"/>
        <di:waypoint x="300" y="210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_agentFlow2" bpmnElement="agentFlow2">
        <di:waypoint x="480" y="210"/>
        <di:waypoint x="520" y="210"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
